class MyHubScreen extends StatelessWidget {
  static const routeName = '/my-hub';

  const MyHubScreen({super.key});

  @override
  Widget build(BuildContext context) {
    final user = FirebaseAuth.instance.currentUser;

    return Scaffold(
      backgroundColor: AppTheme.darkBackground,
      appBar: const UagAppBar(
        title: 'My Hub',
        subtitle: 'Progress, reputation, referrals and raider priorities.',
      ),
      drawer: const AppDrawer(drawerWidth: 300),
      body: Stack(
        fit: StackFit.expand,
        children: [
          const _MyHubBackdrop(),
          SafeArea(
            child: user == null
                ? const Center(
                    child: Text(
                      'Log in to view My Hub.',
                      style: TextStyle(color: Colors.white70),
                    ),
                  )
                : StreamBuilder<DocumentSnapshot<Map<String, dynamic>>>(
                    stream: FirebaseFirestore.instance
                        .collection('users')
                        .doc(user.uid)
                        .snapshots(),
                    builder: (context, snapshot) {
                      final data = snapshot.data?.data() ?? {};
                      return _MyHubContent(userData: data, email: user.email);
                    },
                  ),
          ),
        ],
      ),
    );
  }
}

class _MyHubContent extends StatelessWidget {
  const _MyHubContent({required this.userData, required this.email});

  final Map<String, dynamic> userData;
  final String? email;

  String _readString(List<String> keys, String fallback) {
    for (final key in keys) {
      final value = userData[key];
      if (value is String && value.trim().isNotEmpty) return value.trim();
    }

    final basicProfile = userData['basicProfile'];
    if (basicProfile is Map<String, dynamic>) {
      for (final key in keys) {
        final value = basicProfile[key];
        if (value is String && value.trim().isNotEmpty) return value.trim();
      }
    }

    final traderProfile = userData['traderProfile'];
    if (traderProfile is Map<String, dynamic>) {
      for (final key in keys) {
        final value = traderProfile[key];
        if (value is String && value.trim().isNotEmpty) return value.trim();
      }
    }

    return fallback;
  }

  bool _readBool(String key) => userData[key] == true;

  int _readInt(String key, int fallback) {
    final value = userData[key];
    if (value is int) return value;
    if (value is num) return value.toInt();
    return fallback;
  }

  double _readDouble(String key, double fallback) {
    final value = userData[key];
    if (value is num) return value.toDouble();
    return fallback;
  }

  String get _displayName =>
      _readString(['displayName', 'uagName', 'traderName'], 'Raider');

  String get _tier => _readString(['subscriptionTier'], 'Raider');

  String get _referralCode => _readString(['referralCode'], 'SETUP-PENDING');

  String get _region => _readString(['region', 'country'], 'UK');

  String get _platform => _readString(['platform', 'preferredPlatform'], 'PC');

  int get _successfulTrades => _readInt('successfulTrades', 0);

  int get _verifiedIntel => _readInt('verifiedIntelReports', 0);

  int get _activeReferrals => _readInt('activeReferrals', 0);

  double get _commissionRate => _readDouble(
    'referralCommissionRate',
    _tier.toLowerCase() == 'overseer'
        ? 10
        : _tier.toLowerCase() == 'operator'
        ? 5
        : 0,
  );

  double get _maxCommission => _tier.toLowerCase() == 'overseer'
      ? 25
      : _tier.toLowerCase() == 'operator'
      ? 15
      : 0;

  @override
  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final compact = constraints.maxWidth < 820;

        return SingleChildScrollView(
          padding: EdgeInsets.fromLTRB(
            compact ? 12 : 24,
            compact ? 12 : 22,
            compact ? 12 : 24,
            28,
          ),
          child: Center(
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 1240),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  _HeroPanel(
                    displayName: _displayName,
                    tier: _tier,
                    referralCode: _referralCode,
                    region: _region,
                    platform: _platform,
                    commissionRate: _commissionRate,
                    maxCommission: _maxCommission,
                    activeReferrals: _activeReferrals,
                  ),
                  const SizedBox(height: 18),
                  _ResponsiveGrid(
                    compact: compact,
                    children: [
                      _SubscriptionPanel(
                        tier: _tier,
                        commissionRate: _commissionRate,
                        maxCommission: _maxCommission,
                      ),
                      _ReferralPanel(
                        referralCode: _referralCode,
                        activeReferrals: _activeReferrals,
                        commissionRate: _commissionRate,
                        maxCommission: _maxCommission,
                      ),
                      _ReputationPanel(
                        successfulTrades: _successfulTrades,
                        verifiedIntel: _verifiedIntel,
                      ),
                      _MonthlyOperationsPanel(
                        successfulTrades: _successfulTrades,
                        verifiedIntel: _verifiedIntel,
                        activeReferrals: _activeReferrals,
                      ),
                      const _HuntPrioritiesPanel(),
                      const _FavouriteLoadoutPanel(),
                    ],
                  ),
                  const SizedBox(height: 18),
                  _QuickActionsPanel(
                    email: email ?? '',
                    affiliateApplied: _readBool('affiliateApplied'),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}

