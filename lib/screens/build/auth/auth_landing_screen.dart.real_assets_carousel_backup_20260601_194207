  Widget _background() {
    return Stack(
      fit: StackFit.expand,
      children: [
        const Positioned.fill(child: StaticWatermark()),
        DecoratedBox(
          decoration: BoxDecoration(
            gradient: RadialGradient(
              center: const Alignment(0.15, -0.25),
