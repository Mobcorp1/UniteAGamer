                    ],
                  ),
                ),
              ),
            ),
            Align(
              alignment: Alignment.topLeft,
              child: Container(
                width: 42,
                height: 42,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: Colors.black.withValues(alpha: 0.42),
                  border: Border.all(
                    color: feature.accent.withValues(alpha: 0.8),
                  ),
                ),
                child: Icon(feature.icon, color: feature.accent, size: 24),
              ),
            ),
            Align(
              alignment: Alignment.center,
              child: Icon(
                feature.icon,
                size: 62,
                color: feature.accent.withValues(alpha: 0.88),
                shadows: [
                  Shadow(
                    color: feature.accent.withValues(alpha: 0.74),
                    blurRadius: 18,
                  ),
                ],
              ),
            ),
            Positioned(
              left: 0,
              right: 0,
              bottom: 0,
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    feature.title.toUpperCase(),
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
