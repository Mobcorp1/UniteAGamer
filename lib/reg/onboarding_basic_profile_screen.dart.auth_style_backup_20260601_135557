  }

  @override
  Widget build(BuildContext context) {
    if (_isLoading) {
      return const Scaffold(
        backgroundColor: AppTheme.darkBackground,
        body: Stack(
          children: [
            Positioned.fill(child: StaticWatermark()),
            Center(child: CircularProgressIndicator(color: AppTheme.neonCyan)),
