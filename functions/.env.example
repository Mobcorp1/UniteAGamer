# UAG server-side provider configuration example.
# Copy the required non-secret values into the deployed Functions environment.
# Do not commit service-account keys or Stripe secret values.

UAG_MODERATION_PROVIDER=google_natural_language
UAG_MODERATION_PROVIDER_ENABLED=false
UAG_MODERATION_REGION=global
# UAG_MODERATION_PROJECT_ID=unite-a-gamer

UAG_OCR_PROVIDER=google_cloud_vision
UAG_OCR_PROVIDER_ENABLED=false
UAG_OCR_REGION=global
# UAG_OCR_PROJECT_ID=unite-a-gamer

# Stripe secrets are managed separately with Firebase Functions secrets.
# Monthly product bindings already expected by functions/index.js:
# STRIPE_PRICE_ESSENTIAL_MONTHLY=price_...
# STRIPE_PRICE_PREMIUM_MONTHLY=price_...
# STRIPE_PRICE_FOUNDING_SUPPORTER_MONTHLY=price_...
