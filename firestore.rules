rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userAgeVerified(uid) {
      return uid is string &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.ageVerification.verifiedOver18 == true;
    }

    function currentUserAgeVerified() {
      return isSignedIn() && userAgeVerified(request.auth.uid);
    }

    function isAdminOrDev() {
      return userDocExists() &&
        (currentUserData().isAdmin == true || currentUserData().isDev == true);
    }

    function isTrustModerator() {
      return userDocExists() &&
        (currentUserData().isAdmin == true || currentUserData().isDev == true || currentUserData().isModerator == true);
    }

    function ownsExistingDocByOwnerUid() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncomingDocByOwnerUid() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsExistingDocByUserId() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocByUserId() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingDocByUid() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function ownsIncomingDocByUid() {
      return isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isTradingOfferParticipant() {
      return isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    function isIncomingTradingOfferSender() {
      return isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid;
    }

    function isTradingSessionParticipant() {
      return isSignedIn() &&
        (resource.data.traderOneUid == request.auth.uid || resource.data.traderTwoUid == request.auth.uid);
    }

    function isIncomingTradingSessionParticipant() {
      return isSignedIn() &&
        request.resource.data.traderOneUid != request.resource.data.traderTwoUid &&
        (
          request.resource.data.traderOneUid == request.auth.uid ||
          request.resource.data.traderTwoUid == request.auth.uid
        );
    }

    function isMatchInviteParticipant() {
      return isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    function isIncomingMatchInviteSender() {
      return isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.recipientUid != request.auth.uid;
    }

    function blockDocId(blockerUid, blockedUid) {
      return blockerUid + '_' + blockedUid;
    }

    function hasUserBlock(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/uag_user_blocks/$(blockDocId(blockerUid, blockedUid)));
    }

    function noUserBlockBetween(leftUid, rightUid) {
      return leftUid is string &&
        rightUid is string &&
        leftUid != '' &&
        rightUid != '' &&
        !hasUserBlock(leftUid, rightUid) &&
        !hasUserBlock(rightUid, leftUid);
    }

    function isNotificationTarget() {
      return isSignedIn() && resource.data.targetUid == request.auth.uid;
    }

    function isIncomingNotificationActor() {
      return isSignedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid != '';
    }

    function isTradePreparationOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingTradePreparationOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isSessionPlannerParticipant() {
      return isSignedIn() &&
        (
          resource.data.participantOneUid == request.auth.uid ||
          resource.data.participantTwoUid == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        );
    }

    function isIncomingSessionPlannerParticipant() {
      return isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          request.resource.data.participantOneUid == request.auth.uid ||
          request.resource.data.participantTwoUid == request.auth.uid
        );
    }

    function ownerUserCreateIsCommerciallySafe() {
      return request.resource.data.get('isAdmin', false) != true &&
        request.resource.data.get('isDev', false) != true &&
        request.resource.data.get('isModerator', false) != true &&
        request.resource.data.get('closedBetaParticipant', false) != true &&
        request.resource.data.get('betaParticipant', false) != true &&
        request.resource.data.get('beta', {}).get('pricingEligible', false) != true &&
        request.resource.data.get('beta', {}).get('participant', false) != true &&
        request.resource.data.get('foundingRaider', false) != true &&
        request.resource.data.get('founder', false) != true &&
        request.resource.data.get('founderEligible', false) != true &&
        request.resource.data.get('wallOfLegendsEligible', false) != true &&
        request.resource.data.get('wallOfLegendsInducted', false) != true &&
        !(request.resource.data.get('subscriptionStatus', 'inactive') in ['active', 'trialing']) &&
        !(request.resource.data.get('monetisation', {}).get('subscriptionStatus', 'inactive') in ['active', 'trialing']);
    }

    function ownerUserCommercialFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isAdmin',
          'isDev',
          'isModerator',
          'closedBetaParticipant',
          'betaParticipant',
          'beta',
          'founderStatus',
          'foundingRaider',
          'founder',
          'founderEligible',
          'founderRateForfeited',
          'founderRateForfeitedAt',
          'wallOfLegendsEligible',
          'wallOfLegendsInducted',
          'subscriptionTier',
          'tier',
          'planTier',
          'subscriptionStatus',
          'premiumPass',
          'supporter',
          'creatorRewardEntitlements',
          'referralAvailableBalancePence',
          'referralPendingBalancePence',
          'referralTotalEarnedPence',
          'referralDiscountPercent',
          'referralCommissionPercent'
        ]) &&
        !request.resource.data.get('monetisation', {}).diff(
          resource.data.get('monetisation', {})
        ).affectedKeys().hasAny([
          'tier',
          'subscriptionStatus',
          'billingPeriod',
          'stripeCustomerId',
          'stripeSubscriptionId',
          'currentPeriodEnd',
          'premiumPass',
          'supporter',
          'founderRateForfeited',
          'founderRateForfeitedAt',
          'availableBalancePence',
          'pendingBalancePence',
          'totalEarnedPence',
          'referralDiscountPercent',
          'referralCommissionPercent'
        ]);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdminOrDev();
      allow create: if !request.resource.data.keys().hasAny(['raiderContractStats']) &&
        (isAdminOrDev() || (isOwner(userId) && ownerUserCreateIsCommerciallySafe()));
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['raiderContractStats']) &&
        (isAdminOrDev() || (isOwner(userId) && ownerUserCommercialFieldsUnchanged()));
      allow delete: if isOwner(userId) || isAdminOrDev();

      match /arc_blueprints/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_blueprint_targets/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_items/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_states/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_quest_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_bench_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_season_state/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_season_history/{docId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }

      match /personalisation/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /trading_activity/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_tokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_devices/{deviceId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create, update: if (isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.deviceId == deviceId) || isAdminOrDev();
        allow delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_preferences/{preferenceId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if false;
      }

      match /arc_item_protections/{itemId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_item_recommendation_logs/{logId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create: if isOwner(userId) &&
          request.resource.data.uid == userId;
        allow update, delete: if isAdminOrDev();
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdminOrDev();
        allow create: if isAdminOrDev();
      }

      match /monetisation_usage/{usageId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }

      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }
    }

    match /arc_raider_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.status == 'submitted';
      allow read: if isTrustModerator() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow update: if isTrustModerator() || (isSignedIn() && resource.data.reporterUid == request.auth.uid && request.resource.data.reporterUid == resource.data.reporterUid && request.resource.data.status == 'withdrawn' && (resource.data.status == 'draft' || resource.data.status == 'submitted' || resource.data.status == 'pendingReview'));
      allow delete: if false;
    }

    match /arc_raider_contracts/{contractId} {
      allow list: if isSignedIn() &&
        (resource.data.status == 'available' ||
         resource.data.reporterUid == request.auth.uid ||
         resource.data.hunterUid == request.auth.uid ||
         isTrustModerator());
      allow get: if isSignedIn() &&
        (resource.data.status == 'available' ||
         resource.data.reporterUid == request.auth.uid ||
         resource.data.hunterUid == request.auth.uid ||
         isTrustModerator());
      allow create: if isTrustModerator() &&
        request.resource.data.status == 'available' &&
        request.resource.data.hunterUid == '' &&
        request.resource.data.evidence.size() == 0 &&
        !request.resource.data.keys().hasAny(['verificationStatus', 'evidenceSubmissionId',
          'verifiedByUid', 'verifiedAt', 'rejectedAt', 'rejectionReason']);
      allow update: if isSignedIn() &&
        request.resource.data.blueprintRewardPool == resource.data.blueprintRewardPool &&
        request.resource.data.blueprintRewardCount == resource.data.blueprintRewardCount && (
        (resource.data.status == 'available' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.hunterUid == request.auth.uid &&
          request.auth.uid != resource.data.reporterUid &&
          request.auth.uid != resource.data.targetUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'hunterUid', 'acceptedAt', 'updatedAt'])) ||
        (resource.data.hunterUid == request.auth.uid &&
          resource.data.status == 'accepted' && request.resource.data.status == 'inProgress' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        ((resource.data.hunterUid == request.auth.uid || resource.data.reporterUid == request.auth.uid) &&
          resource.data.status in ['inProgress', 'evidenceSubmitted'] &&
          request.resource.data.status == 'disputed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution', 'updatedAt'])) ||
        (resource.data.hunterUid == request.auth.uid &&
          resource.data.status in ['accepted', 'inProgress', 'evidenceSubmitted', 'disputed'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blueprintRewardSelection', 'updatedAt']) &&
          request.resource.data.blueprintRewardSelection is list &&
          request.resource.data.blueprintRewardSelection.size() == resource.data.blueprintRewardCount &&
          request.resource.data.blueprintRewardSelection.toSet().size() == resource.data.blueprintRewardCount &&
          resource.data.blueprintRewardPool.toSet().hasAll(request.resource.data.blueprintRewardSelection.toSet())) ||
        (isTrustModerator() && resource.data.status in ['available', 'accepted', 'inProgress', 'evidenceSubmitted', 'disputed'] &&
          request.resource.data.status in ['rejected', 'cancelled', 'expired'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'resolution', 'moderationNotes', 'moderatedByUid', 'resolvedAt', 'updatedAt'])) ||
        (isAdminOrDev() && resource.data.status == 'completed' &&
          resource.data.get('verificationStatus', '') == 'verified' &&
          resource.data.get('verifiedByUid', '') == resource.data.reporterUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['blueprintRewardsSettled', 'resolution', 'moderatedByUid', 'resolvedAt', 'updatedAt']) &&
          resource.data.get('blueprintRewardsSettled', false) == false &&
          request.resource.data.blueprintRewardsSettled == true)
      );
      allow delete: if false;
      match /verification_audit/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/arc_raider_contracts/$(contractId)).data.reporterUid == request.auth.uid ||
          get(/databases/$(database)/documents/arc_raider_contracts/$(contractId)).data.hunterUid == request.auth.uid || isTrustModerator());
        allow write: if false;
      }
    }

    match /raider_verified_results/{contractId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    match /arc_blueprint_drop_reports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrDev();
    }

    match /arc_admin_map_markers/{markerId} {
      allow read: if isAdminOrDev() ||
        resource.data.state == 'published' ||
        (resource.data.provisionalVisible == true &&
          resource.data.sourcePermission == 'permitted');
      allow create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_evidence/{evidenceId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_import_runs/{runId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_source_config/{sourceId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_calibration_records/{recordId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_exception_queue/{queueId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_duplicate_groups/{groupId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_proposed_matches/{matchId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_coverage_reports/{reportId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_blueprint_report_links/{linkId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_community_intel_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.mapId is string &&
        request.resource.data.layer is string &&
        request.resource.data.category is string &&
        request.resource.data.signature is string;
      allow update: if isAdminOrDev() ||
        (isSignedIn() &&
          request.resource.data.reporterUid == resource.data.reporterUid &&
          request.resource.data.mapId == resource.data.mapId &&
          request.resource.data.layer == resource.data.layer &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.signature == resource.data.signature &&
          request.resource.data.confirmationCount >= 0 &&
          request.resource.data.disputeCount >= 0);
      allow delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.reporterUid == request.auth.uid);
    }

    match /arc_blueprint_demand/{blueprintId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrDev();
    }

    match /arc_trader_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if (currentUserAgeVerified() &&
        (isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId())) ||
        isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trader_availability/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if (currentUserAgeVerified() &&
        (isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId())) ||
        isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trader_away/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if (currentUserAgeVerified() &&
        (isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId())) ||
        isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /trading_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if currentUserAgeVerified() &&
        ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == listingId;
      allow update: if ownsExistingDocByOwnerUid() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.id == resource.data.id;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /trading_offers/{offerId} {
      allow read: if isTradingOfferParticipant() || isAdminOrDev();
      allow create: if currentUserAgeVerified() &&
        userAgeVerified(request.resource.data.receiverUid) &&
        isIncomingTradingOfferSender() &&
        request.resource.data.id == offerId &&
        noUserBlockBetween(
          request.resource.data.senderUid,
          request.resource.data.receiverUid
        );
      allow update: if (isTradingOfferParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.listingId == resource.data.listingId &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.receiverUid == resource.data.receiverUid;
      allow delete: if false;
    }

    match /trading_sessions/{sessionId} {
      allow read: if isTradingSessionParticipant() || isAdminOrDev();
      allow create: if currentUserAgeVerified() &&
        userAgeVerified(request.resource.data.traderOneUid) &&
        userAgeVerified(request.resource.data.traderTwoUid) &&
        isIncomingTradingSessionParticipant() &&
        request.resource.data.id == sessionId;
      allow update: if (isTradingSessionParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.traderOneUid == resource.data.traderOneUid &&
        request.resource.data.traderTwoUid == resource.data.traderTwoUid;
      allow delete: if false;
    }

    match /trading_notifications/{notificationId} {
      allow read: if isNotificationTarget() || isAdminOrDev();
      allow create: if isIncomingNotificationActor() && request.resource.data.id == notificationId;
      allow update: if (isNotificationTarget() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        request.resource.data.actorUid == resource.data.actorUid;
      allow delete: if isNotificationTarget() || isAdminOrDev();
    }

    match /arc_trade_preparations/{preparationId} {
      allow read: if isTradePreparationOwner() || isAdminOrDev();
      allow create: if isIncomingTradePreparationOwner() &&
        request.resource.data.id == preparationId;
      allow update: if (isTradePreparationOwner() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isTradePreparationOwner() || isAdminOrDev();
    }

    match /arc_favourite_riders/{favouriteId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == favouriteId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_blueprint_watches/{watchId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == watchId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_trade_offer_preferences/{ownerUid} {
      allow read: if isOwner(ownerUid) || isAdminOrDev();
      allow create, update: if (isOwner(ownerUid) &&
        request.resource.data.ownerUid == ownerUid) || isAdminOrDev();
      allow delete: if isOwner(ownerUid) || isAdminOrDev();
    }

    match /arc_trade_listing_queue/{queueId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == queueId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_notification_queue/{notificationId} {
      allow read: if isNotificationTarget() || isAdminOrDev();
      allow create: if isIncomingNotificationActor() &&
        request.resource.data.id == notificationId;
      allow update: if (isNotificationTarget() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        request.resource.data.actorUid == resource.data.actorUid;
      allow delete: if isNotificationTarget() || isAdminOrDev();
    }

    match /notification_broadcasts/{broadcastId} {
      allow read: if isAdminOrDev();
      allow create: if isAdminOrDev() &&
        request.resource.data.id == broadcastId &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /notification_delivery_reports/{reportId} {
      allow read: if isAdminOrDev();
      allow create, update, delete: if false;
    }

    match /uag_notification_schedules/{scheduleId} {
      allow read: if isSignedIn() &&
        (resource.data.targetUid == request.auth.uid || isAdminOrDev());
      allow create: if isSignedIn() &&
        request.resource.data.id == scheduleId &&
        request.resource.data.targetUid == request.auth.uid &&
        request.resource.data.status == 'queued';
      allow update: if isAdminOrDev() || (
        isSignedIn() &&
        resource.data.targetUid == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        (request.resource.data.status == 'queued' ||
          request.resource.data.status == 'cancelled')
      );
      allow delete: if isAdminOrDev();
    }

    match /arc_match_rider_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if ((currentUserAgeVerified() &&
        isOwner(profileUid) &&
        request.resource.data.uid == request.auth.uid) || isAdminOrDev());
      allow delete: if isOwner(profileUid) || isAdminOrDev();
    }

    match /arc_match_rider_invites/{inviteId} {
      allow read: if isMatchInviteParticipant() || isAdminOrDev();
      allow create: if currentUserAgeVerified() &&
        userAgeVerified(request.resource.data.recipientUid) &&
        isIncomingMatchInviteSender() &&
        request.resource.data.id == inviteId &&
        noUserBlockBetween(
          request.resource.data.senderUid,
          request.resource.data.recipientUid
        );
      allow update: if (isMatchInviteParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if false;
    }

    match /arc_trade_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if currentUserAgeVerified() &&
        ownsIncomingDocByUserId() &&
        request.resource.data.id == listingId;
      allow update: if ownsExistingDocByUserId() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.id == resource.data.id;
      allow delete: if ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trade_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if currentUserAgeVerified() &&
        (
          request.resource.data.traderOneUid == request.auth.uid ||
          request.resource.data.traderTwoUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        );
      allow update: if isSignedIn() &&
        (
          resource.data.traderOneUid == request.auth.uid ||
          resource.data.traderTwoUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdminOrDev()
        );
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isSessionPlannerParticipant() || isAdminOrDev();
      allow list: if isSignedIn();
      allow create: if (currentUserAgeVerified() &&
        isIncomingSessionPlannerParticipant()) || isAdminOrDev();
      allow update: if (isSessionPlannerParticipant() || isAdminOrDev()) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.participantOneUid == resource.data.participantOneUid &&
        request.resource.data.participantTwoUid == resource.data.participantTwoUid;
      allow delete: if false;
    }

    match /uag_sessions/{sessionId} {
      allow read: if isSessionPlannerParticipant() || isAdminOrDev();
      allow list: if isSignedIn();
      allow create: if (currentUserAgeVerified() &&
        isIncomingSessionPlannerParticipant()) || isAdminOrDev();
      allow update: if (isSessionPlannerParticipant() || isAdminOrDev()) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.participantOneUid == resource.data.participantOneUid &&
        request.resource.data.participantTwoUid == resource.data.participantTwoUid;
      allow delete: if false;
    }

    match /beta_feedback/{feedbackId} {
  allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
  allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdminOrDev());
  allow update: if isAdminOrDev() || (isSignedIn() && resource.data.uid == request.auth.uid);
  allow delete: if isAdminOrDev();

  match /replies/{replyId} {
    allow read: if isSignedIn() && (
      get(/databases/$(database)/documents/beta_feedback/$(feedbackId)).data.uid == request.auth.uid ||
      isAdminOrDev()
    );

    allow create: if isSignedIn() && (
      isAdminOrDev() ||
      get(/databases/$(database)/documents/beta_feedback/$(feedbackId)).data.uid == request.auth.uid
    );

    allow update: if isAdminOrDev();
    allow delete: if isAdminOrDev();
  }
}
    match /arc_operation_progress/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /operations/{operationId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_operation_telemetry/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /events/{eventId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_rewards_inventory/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /items/{rewardId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_equipped_cosmetics/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();
    }

    match /legal_policies/{policyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /arc_item_dataset_versions/{versionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrDev();
      allow delete: if false;
    }

    match /uag_creator_applications/{applicationId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == applicationId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdminOrDev();
    }

    match /uag_creator_campaign_code_requests/{codeId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == codeId &&
        request.resource.data.code == codeId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending_admin_approval';
      allow update, delete: if isAdminOrDev();
    }

    match /uag_creator_dashboard_aggregates/{creatorUid} {
      allow read: if isOwner(creatorUid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }

    match /uag_creator_commission_ledgers/{creatorUid} {
      allow read: if isOwner(creatorUid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();

      match /entries/{entryId} {
        allow read: if isOwner(creatorUid) || isAdminOrDev();
        allow create, update, delete: if isAdminOrDev();
      }
    }

    match /uag_creator_referred_subscriptions/{subscriptionId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.creatorUid == request.auth.uid);
      allow create, update, delete: if isAdminOrDev();
    }


    match /uag_community_referral_paid_subscriptions/{subscriptionId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.referrerUid == request.auth.uid);
      allow create, update, delete: if isAdminOrDev();
    }

    match /uag_community_referral_commission_ledgers/{referrerUid} {
      allow read: if isOwner(referrerUid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();

      match /entries/{entryId} {
        allow read: if isOwner(referrerUid) || isAdminOrDev();
        allow create, update, delete: if isAdminOrDev();
      }
    }

    match /uag_community_referral_codes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.code == codeId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.termsVersion is string &&
        request.resource.data.termsVersion != '';
      allow update, delete: if isAdminOrDev();
    }

    match /uag_referral_terms_acceptances/{uid} {
      allow read: if isOwner(uid) || isAdminOrDev();
      allow create, update: if isOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.version is string &&
        request.resource.data.version != '' &&
        request.resource.data.accepted == true;
      allow delete: if isAdminOrDev();
    }

    match /uag_community_referral_validation_queue/{queueId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /uag_age_verification_requests/{requestId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.id == requestId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdminOrDev() ||
        (
          isSignedIn() &&
          resource.data.uid == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'status',
            'appealReason',
            'updatedAt'
          ]) &&
          request.resource.data.status == 'appealed'
        );
      allow delete: if isAdminOrDev();
    }

    match /uag_user_blocks/{blockId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.blockerUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.id == blockId &&
        request.resource.data.blockerUid == request.auth.uid &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid != request.auth.uid;
      allow update: if false;
      allow delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.blockerUid == request.auth.uid);
    }

    match /uag_message_outbox/{messageId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (
            resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid
          )
        );
      allow create: if currentUserAgeVerified() &&
        userAgeVerified(request.resource.data.recipientUid) &&
        request.resource.data.id == messageId &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.recipientUid is string &&
        request.resource.data.recipientUid != request.auth.uid &&
        request.resource.data.status == 'queued' &&
        noUserBlockBetween(
          request.resource.data.senderUid,
          request.resource.data.recipientUid
        );
      allow update, delete: if false;
    }

    match /uag_messages/{messageId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (
            resource.data.senderUid == request.auth.uid ||
            resource.data.recipientUid == request.auth.uid
          )
        );
      allow create, update, delete: if isAdminOrDev();
    }

    match /uag_message_reports/{reportId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (
            resource.data.reporterUid == request.auth.uid ||
            resource.data.reportedUid == request.auth.uid
          )
        );
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == reportId &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reportedUid != request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /uag_conversation_reports/{reportId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (
            resource.data.reporterUid == request.auth.uid ||
            resource.data.reportedUid == request.auth.uid
          )
        );
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == reportId &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reportedUid != request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /uag_moderation_queue/{queueId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /legal_acceptance_events/{eventId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.policyId is string &&
        request.resource.data.version is int;
      allow update, delete: if false;
    }

    match /data_rights_requests/{requestId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /copyright_takedown_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /uag_conduct_reports/{reportId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.reporterUid == request.auth.uid ||
            resource.data.subjectUid == request.auth.uid)
        );
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == reportId &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.subjectUid != request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /uag_community_contracts/{contractId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid ||
            resource.data.assigneeUid == request.auth.uid)
        );
      allow create: if currentUserAgeVerified() &&
        userAgeVerified(request.resource.data.assigneeUid) &&
        request.resource.data.id == contractId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.assigneeUid != request.auth.uid;
      allow update: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid ||
            resource.data.assigneeUid == request.auth.uid) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.assigneeUid == resource.data.assigneeUid
        );
      allow delete: if isAdminOrDev();

      match /evidence/{evidenceId} {
        allow read: if isAdminOrDev() ||
          (
            isSignedIn() &&
            (
              get(/databases/$(database)/documents/uag_community_contracts/$(contractId)).data.ownerUid == request.auth.uid ||
              get(/databases/$(database)/documents/uag_community_contracts/$(contractId)).data.assigneeUid == request.auth.uid
            )
          );
        allow create: if currentUserAgeVerified() &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdminOrDev();
      }
    }

    match /uag_image_import_sessions/{sessionId} {
      allow read, update, delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if currentUserAgeVerified() &&
        request.resource.data.id == sessionId &&
        request.resource.data.uid == request.auth.uid;
    }

    match /uag_voice_preferences/{uid} {
      allow read, create, update: if isOwner(uid) || isAdminOrDev();
      allow delete: if isAdminOrDev();
    }

    match /supporter_programme_content/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /supporter_entitlements/{uid} {
      allow read: if isOwner(uid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }
 match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrDev();
      allow delete: if false;
    }

    match /system_counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        counterId == 'arc_trader_ids' &&
        request.resource.data.lastIssuedNumber is int &&
        request.resource.data.lastIssuedNumber >= 0 &&
        request.resource.data.lastIssuedNumber <= 400000000;
      allow delete: if false;
    }

    match /referral_codes/{code} {
      allow read: if isSignedIn();
      allow create: if currentUserAgeVerified() &&
        request.resource.data.code == code &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.code == resource.data.code;
      allow delete: if false;
    }

    match /referral_wallets/{uid} {
      allow read: if isOwner(uid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();

      match /ledger/{ledgerId} {
        allow read: if isOwner(uid) || isAdminOrDev();
        allow create, update, delete: if isAdminOrDev();
      }
    }


    match /payout_requests/{requestId} {
      allow read: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
      allow create: if currentUserAgeVerified() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.amountPence is int &&
        request.resource.data.amountPence > 0 &&
        request.resource.data.amountPence <= 1000000;
      allow update, delete: if isAdminOrDev();
    }

    match /impact_pots/{potId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }
    match /uag_referral_reward_lockers/{userId} {
      allow read: if isOwner(userId) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();

      match /rewards/{rewardId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create, update, delete: if isAdminOrDev();
      }
    }

    match /uag_referral_reward_activation_requests/{requestId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.rewardId is string &&
        request.resource.data.rewardId != '';
      allow update, delete: if isAdminOrDev();
    }

    match /monetisation_events/{eventId} {
      allow read: if isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }

    match /monetisation_checkout_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
      allow create, update, delete: if isAdminOrDev();
    }

    match /uag_ids/{uagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uagId == uagId;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.uagId == resource.data.uagId;
      allow delete: if false;
    }

    match /public_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId() || isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /dose_tasks/{taskId} {
      allow read, create, update, delete: if isSignedIn() &&
        (
          request.resource.data.uid == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
    }

    match /uag_community_suggestions/{suggestionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 80;
      allow update, delete: if isAdminOrDev();

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && voterUid == request.auth.uid &&
          request.resource.data.uid == request.auth.uid;
        allow delete: if isSignedIn() && voterUid == request.auth.uid;
        allow update: if false;
      }
    }

    match /uag_commercial_recognition/{userId} {
      allow read: if isOwner(userId) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }

    match /wall_of_legends/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }
  }
}



