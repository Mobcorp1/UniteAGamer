rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOrDev() {
      return userDocExists() &&
        (currentUserData().isAdmin == true || currentUserData().isDev == true);
    }

    function ownsExistingDocByOwnerUid() {
      return isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncomingDocByOwnerUid() {
      return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function ownsExistingDocByUserId() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocByUserId() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsExistingDocByUid() {
      return isSignedIn() && resource.data.uid == request.auth.uid;
    }

    function ownsIncomingDocByUid() {
      return isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    function isTradingOfferParticipant() {
      return isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
    }

    function isIncomingTradingOfferSender() {
      return isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.receiverUid != request.auth.uid;
    }

    function isTradingSessionParticipant() {
      return isSignedIn() &&
        (resource.data.traderOneUid == request.auth.uid || resource.data.traderTwoUid == request.auth.uid);
    }

    function isIncomingTradingSessionParticipant() {
      return isSignedIn() &&
        request.resource.data.traderOneUid != request.resource.data.traderTwoUid &&
        (
          request.resource.data.traderOneUid == request.auth.uid ||
          request.resource.data.traderTwoUid == request.auth.uid
        );
    }

    function isMatchInviteParticipant() {
      return isSignedIn() &&
        (resource.data.senderUid == request.auth.uid || resource.data.recipientUid == request.auth.uid);
    }

    function isIncomingMatchInviteSender() {
      return isSignedIn() &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.recipientUid != request.auth.uid;
    }

    function isNotificationTarget() {
      return isSignedIn() && resource.data.targetUid == request.auth.uid;
    }

    function isIncomingNotificationActor() {
      return isSignedIn() &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.targetUid is string &&
        request.resource.data.targetUid != '';
    }

    function isTradePreparationOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function isIncomingTradePreparationOwner() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isSessionPlannerParticipant() {
      return isSignedIn() &&
        (
          resource.data.participantOneUid == request.auth.uid ||
          resource.data.participantTwoUid == request.auth.uid ||
          resource.data.createdBy == request.auth.uid
        );
    }

    function isIncomingSessionPlannerParticipant() {
      return isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        (
          request.resource.data.participantOneUid == request.auth.uid ||
          request.resource.data.participantTwoUid == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();

      match /arc_blueprints/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_blueprint_targets/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_items/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_states/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_quest_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_scrappy_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_bench_progress/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_season_state/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /arc_season_history/{docId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }

      match /trading_activity/{docId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_tokens/{tokenId} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_devices/{deviceId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create, update: if (isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.deviceId == deviceId) || isAdminOrDev();
        allow delete: if isOwner(userId) || isAdminOrDev();
      }

      match /notification_preferences/{preferenceId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdminOrDev();
        allow create: if isAdminOrDev();
      }

      match /monetisation_usage/{usageId} {
        allow read: if isOwner(userId) || isAdminOrDev();
        allow create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }

      match /{document=**} {
        allow read, create, update, delete: if isOwner(userId) || isAdminOrDev();
      }
    }

    match /arc_blueprint_drop_reports/{reportId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrDev();
    }

    match /arc_admin_map_markers/{markerId} {
      allow read: if isAdminOrDev() ||
        resource.data.state == 'published' ||
        (resource.data.provisionalVisible == true &&
          resource.data.sourcePermission == 'permitted');
      allow create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_evidence/{evidenceId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_import_runs/{runId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_source_config/{sourceId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_calibration_records/{recordId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_exception_queue/{queueId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_duplicate_groups/{groupId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_proposed_matches/{matchId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_map_marker_coverage_reports/{reportId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_blueprint_report_links/{linkId} {
      allow read, create, update, delete: if isAdminOrDev();
    }

    match /arc_community_intel_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.mapId is string &&
        request.resource.data.layer is string &&
        request.resource.data.category is string &&
        request.resource.data.signature is string;
      allow update: if isAdminOrDev() ||
        (isSignedIn() &&
          request.resource.data.reporterUid == resource.data.reporterUid &&
          request.resource.data.mapId == resource.data.mapId &&
          request.resource.data.layer == resource.data.layer &&
          request.resource.data.category == resource.data.category &&
          request.resource.data.signature == resource.data.signature &&
          request.resource.data.confirmationCount >= 0 &&
          request.resource.data.disputeCount >= 0);
      allow delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.reporterUid == request.auth.uid);
    }

    match /arc_blueprint_demand/{blueprintId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrDev();
    }

    match /arc_trader_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId() || isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trader_availability/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId() || isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trader_away/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId() || isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /trading_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if ownsIncomingDocByOwnerUid() && request.resource.data.id == listingId;
      allow update: if ownsExistingDocByOwnerUid() &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.id == resource.data.id;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /trading_offers/{offerId} {
      allow read: if isTradingOfferParticipant() || isAdminOrDev();
      allow create: if isIncomingTradingOfferSender() && request.resource.data.id == offerId;
      allow update: if (isTradingOfferParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.listingId == resource.data.listingId &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.receiverUid == resource.data.receiverUid;
      allow delete: if false;
    }

    match /trading_sessions/{sessionId} {
      allow read: if isTradingSessionParticipant() || isAdminOrDev();
      allow create: if isIncomingTradingSessionParticipant() && request.resource.data.id == sessionId;
      allow update: if (isTradingSessionParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.traderOneUid == resource.data.traderOneUid &&
        request.resource.data.traderTwoUid == resource.data.traderTwoUid;
      allow delete: if false;
    }

    match /trading_notifications/{notificationId} {
      allow read: if isNotificationTarget() || isAdminOrDev();
      allow create: if isIncomingNotificationActor() && request.resource.data.id == notificationId;
      allow update: if (isNotificationTarget() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        request.resource.data.actorUid == resource.data.actorUid;
      allow delete: if isNotificationTarget() || isAdminOrDev();
    }

    match /arc_trade_preparations/{preparationId} {
      allow read: if isTradePreparationOwner() || isAdminOrDev();
      allow create: if isIncomingTradePreparationOwner() &&
        request.resource.data.id == preparationId;
      allow update: if (isTradePreparationOwner() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isTradePreparationOwner() || isAdminOrDev();
    }

    match /arc_favourite_riders/{favouriteId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == favouriteId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_blueprint_watches/{watchId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == watchId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_trade_offer_preferences/{ownerUid} {
      allow read: if isOwner(ownerUid) || isAdminOrDev();
      allow create, update: if (isOwner(ownerUid) &&
        request.resource.data.ownerUid == ownerUid) || isAdminOrDev();
      allow delete: if isOwner(ownerUid) || isAdminOrDev();
    }

    match /arc_trade_listing_queue/{queueId} {
      allow read: if ownsExistingDocByOwnerUid() || isAdminOrDev();
      allow create: if ownsIncomingDocByOwnerUid() &&
        request.resource.data.id == queueId;
      allow update: if (ownsExistingDocByOwnerUid() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if ownsExistingDocByOwnerUid() || isAdminOrDev();
    }

    match /arc_notification_queue/{notificationId} {
      allow read: if isNotificationTarget() || isAdminOrDev();
      allow create: if isIncomingNotificationActor() &&
        request.resource.data.id == notificationId;
      allow update: if (isNotificationTarget() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        request.resource.data.actorUid == resource.data.actorUid;
      allow delete: if isNotificationTarget() || isAdminOrDev();
    }

    match /notification_broadcasts/{broadcastId} {
      allow read: if isAdminOrDev();
      allow create: if isAdminOrDev() &&
        request.resource.data.id == broadcastId &&
        request.resource.data.senderUid == request.auth.uid &&
        request.resource.data.status == 'queued';
      allow update, delete: if false;
    }

    match /notification_delivery_reports/{reportId} {
      allow read: if isAdminOrDev();
      allow create, update, delete: if false;
    }

    match /uag_notification_schedules/{scheduleId} {
      allow read: if isSignedIn() &&
        (resource.data.targetUid == request.auth.uid || isAdminOrDev());
      allow create: if isSignedIn() &&
        request.resource.data.id == scheduleId &&
        request.resource.data.targetUid == request.auth.uid &&
        request.resource.data.status == 'queued';
      allow update: if isAdminOrDev() || (
        isSignedIn() &&
        resource.data.targetUid == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.targetUid == resource.data.targetUid &&
        (request.resource.data.status == 'queued' ||
          request.resource.data.status == 'cancelled')
      );
      allow delete: if isAdminOrDev();
    }

    match /arc_match_rider_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(profileUid) && request.resource.data.uid == request.auth.uid) || isAdminOrDev();
      allow delete: if isOwner(profileUid) || isAdminOrDev();
    }

    match /arc_match_rider_invites/{inviteId} {
      allow read: if isMatchInviteParticipant() || isAdminOrDev();
      allow create: if isIncomingMatchInviteSender() && request.resource.data.id == inviteId;
      allow update: if (isMatchInviteParticipant() || isAdminOrDev()) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.senderUid == resource.data.senderUid &&
        request.resource.data.recipientUid == resource.data.recipientUid;
      allow delete: if false;
    }

    match /arc_trade_listings/{listingId} {
      allow read: if isSignedIn();
      allow create: if ownsIncomingDocByUserId() && request.resource.data.id == listingId;
      allow update: if ownsExistingDocByUserId() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.id == resource.data.id;
      allow delete: if ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /arc_trade_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (
          request.resource.data.traderOneUid == request.auth.uid ||
          request.resource.data.traderTwoUid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          request.resource.data.ownerUid == request.auth.uid
        );
      allow update: if isSignedIn() &&
        (
          resource.data.traderOneUid == request.auth.uid ||
          resource.data.traderTwoUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid ||
          isAdminOrDev()
        );
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read: if isSessionPlannerParticipant() || isAdminOrDev();
      allow list: if isSignedIn();
      allow create: if isIncomingSessionPlannerParticipant() || isAdminOrDev();
      allow update: if (isSessionPlannerParticipant() || isAdminOrDev()) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.participantOneUid == resource.data.participantOneUid &&
        request.resource.data.participantTwoUid == resource.data.participantTwoUid;
      allow delete: if false;
    }

    match /uag_sessions/{sessionId} {
      allow read: if isSessionPlannerParticipant() || isAdminOrDev();
      allow list: if isSignedIn();
      allow create: if isIncomingSessionPlannerParticipant() || isAdminOrDev();
      allow update: if (isSessionPlannerParticipant() || isAdminOrDev()) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.participantOneUid == resource.data.participantOneUid &&
        request.resource.data.participantTwoUid == resource.data.participantTwoUid;
      allow delete: if false;
    }

    match /beta_feedback/{feedbackId} {
  allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
  allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdminOrDev());
  allow update: if isAdminOrDev() || (isSignedIn() && resource.data.uid == request.auth.uid);
  allow delete: if isAdminOrDev();

  match /replies/{replyId} {
    allow read: if isSignedIn() && (
      get(/databases/$(database)/documents/beta_feedback/$(feedbackId)).data.uid == request.auth.uid ||
      isAdminOrDev()
    );

    allow create: if isSignedIn() && (
      isAdminOrDev() ||
      get(/databases/$(database)/documents/beta_feedback/$(feedbackId)).data.uid == request.auth.uid
    );

    allow update: if isAdminOrDev();
    allow delete: if isAdminOrDev();
  }
}
    match /arc_operation_progress/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /operations/{operationId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_operation_telemetry/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /events/{eventId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_rewards_inventory/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();

      match /items/{rewardId} {
        allow read, create, update: if isOwner(userId) || isAdminOrDev();
        allow delete: if isAdminOrDev();
      }
    }

    match /arc_equipped_cosmetics/{userId} {
      allow read, create, update: if isOwner(userId) || isAdminOrDev();
      allow delete: if isAdminOrDev();
    }

    match /legal_policies/{policyId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /legal_acceptance_events/{eventId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.policyId is string &&
        request.resource.data.version is int;
      allow update, delete: if false;
    }

    match /data_rights_requests/{requestId} {
      allow read: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /copyright_takedown_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /uag_conduct_reports/{reportId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.reporterUid == request.auth.uid ||
            resource.data.subjectUid == request.auth.uid)
        );
      allow create: if isSignedIn() &&
        request.resource.data.id == reportId &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.subjectUid != request.auth.uid;
      allow update, delete: if isAdminOrDev();
    }

    match /uag_community_contracts/{contractId} {
      allow read: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid ||
            resource.data.assigneeUid == request.auth.uid)
        );
      allow create: if isSignedIn() &&
        request.resource.data.id == contractId &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.assigneeUid != request.auth.uid;
      allow update: if isAdminOrDev() ||
        (
          isSignedIn() &&
          (resource.data.ownerUid == request.auth.uid ||
            resource.data.assigneeUid == request.auth.uid) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.assigneeUid == resource.data.assigneeUid
        );
      allow delete: if isAdminOrDev();

      match /evidence/{evidenceId} {
        allow read: if isAdminOrDev() ||
          (
            isSignedIn() &&
            (
              get(/databases/$(database)/documents/uag_community_contracts/$(contractId)).data.ownerUid == request.auth.uid ||
              get(/databases/$(database)/documents/uag_community_contracts/$(contractId)).data.assigneeUid == request.auth.uid
            )
          );
        allow create: if isSignedIn() &&
          request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isAdminOrDev();
      }
    }

    match /uag_image_import_sessions/{sessionId} {
      allow read, update, delete: if isAdminOrDev() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.id == sessionId &&
        request.resource.data.uid == request.auth.uid;
    }

    match /uag_voice_preferences/{uid} {
      allow read, create, update: if isOwner(uid) || isAdminOrDev();
      allow delete: if isAdminOrDev();
    }

    match /supporter_programme_content/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /supporter_entitlements/{uid} {
      allow read: if isOwner(uid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }
 match /config/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isAdminOrDev();
      allow delete: if false;
    }

    match /system_counters/{counterId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        counterId == 'arc_trader_ids' &&
        request.resource.data.lastIssuedNumber is int &&
        request.resource.data.lastIssuedNumber >= 0 &&
        request.resource.data.lastIssuedNumber <= 400000000;
      allow delete: if false;
    }

    match /referral_codes/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.code == code &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.code == resource.data.code;
      allow delete: if false;
    }

    match /referral_wallets/{uid} {
      allow read: if isOwner(uid) || isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();

      match /ledger/{ledgerId} {
        allow read: if isOwner(uid) || isAdminOrDev();
        allow create, update, delete: if isAdminOrDev();
      }
    }


    match /payout_requests/{requestId} {
      allow read: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.amountPence is int &&
        request.resource.data.amountPence > 0 &&
        request.resource.data.amountPence <= 1000000;
      allow update, delete: if isAdminOrDev();
    }

    match /impact_pots/{potId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }

    match /monetisation_events/{eventId} {
      allow read: if isAdminOrDev();
      allow create, update, delete: if isAdminOrDev();
    }

    match /monetisation_checkout_sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (
          resource.data.uid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
      allow create, update, delete: if isAdminOrDev();
    }

    match /uag_ids/{uagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uagId == uagId;
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.uagId == resource.data.uagId;
      allow delete: if false;
    }

    match /public_profiles/{profileUid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileUid) || ownsIncomingDocByUid() || ownsIncomingDocByUserId() || isAdminOrDev();
      allow delete: if isOwner(profileUid) || ownsExistingDocByUid() || ownsExistingDocByUserId() || isAdminOrDev();
    }

    match /dose_tasks/{taskId} {
      allow read, create, update, delete: if isSignedIn() &&
        (
          request.resource.data.uid == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          request.resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          isAdminOrDev()
        );
    }

    match /wall_of_legends/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdminOrDev();
    }
  }
}
