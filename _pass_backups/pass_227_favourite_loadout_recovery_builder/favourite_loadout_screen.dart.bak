    ];

    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          'BUILDER FLOW',
          style: AppTheme.tradingHeading(
            fontSize: 19,
            color: AppTheme.neonPink,
